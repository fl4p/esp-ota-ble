index 8bc8334..270a37a 100644
--- a/src/bleota.h
+++ b/src/bleota.h
@@ -202,6 +202,42 @@ bool ble_ota_flash_busy(void);
  * and hard-ceiling deadlines. */
 void ble_ota_tick(void);
 
+/* ---- The same receiver over USB serial --------------------------------
+ *
+ * esp-ota-ble is transport-agnostic by contract (ota_ble.h: "This module knows
+ * nothing about BLE"), and ota_status_hook already mirrors every OTAB line to
+ * Serial, so a serial host's line parser works with no firmware change. What
+ * was missing is a way in: the OTA verbs were dispatched only from the BLE
+ * control characteristic. These four are that way in, and they exist here
+ * rather than in main.cpp because main.cpp includes this header, not
+ * <ota_ble.h>.
+ *
+ * NOT gated on the BLE window. ble_ota_tick() early-returns on `!up`, so the
+ * serial path must not go through it - with the radio down that would stage
+ * bytes nothing ever drains, straight into OTAB FAIL credit-overrun. */
+
+/* Submit one control line ("begin <size> <sha256hex>", "end", "abort",
+ * "info") to the receiver. Safe from any task; the command is LATCHED, so
+ * call ble_ota_serial_pump() to execute it. True when it was accepted. */
+bool ble_ota_serial_submit(const char *line);
+
+/* Stage firmware bytes AND drain them. The drain is not optional: unlike the
+ * BLE path there is no credit window pacing a serial host, and
+ * otaBleStageBytes() neither blocks nor drops when the ring is full - it
+ * latches a failure that surfaces as OTAB FAIL credit-overrun. Staging and
+ * draining on one task serialises them, which is exactly the flow control:
+ * while this blocks on flash the CDC FIFO backs up and the host's write()
+ * blocks. */
+void ble_ota_serial_stage(const uint8_t *d, size_t n);
+
+/* Run the consumer once, to execute a latched command (a `begin` erases here,
+ * which takes seconds) or to keep a stalled transfer's deadlines moving. */
+void ble_ota_serial_pump(void);
+
+/* True between a successful `begin` and its end/abort, asked of the receiver
+ * itself rather than of the BLE session. */
+bool ble_ota_serial_active(void);
+
 /* One Modbus exchange on the RS-485 bus: write `req`, return the reply in
  * `rsp`, or 0 for silence. Supplied by the application because this module
  * owns no wire - main.cpp has Serial1, the drain-then-ask discipline and the
@@ -340,4 +376,13 @@ static inline bool ble_telem_active(void) { return false; }
 static inline bool ble_take_telem_request(uint16_t *, uint16_t *) { return false; }
 static inline void ble_report_telem(uint16_t, uint16_t, bool) {}
 
+/* Serial OTA compiles out with the receiver, not with the radio - but the
+ * receiver is what PROTO_BLE_OTA gates, and without it there is nothing to
+ * submit bytes to. A build with no receiver refuses the verbs rather than
+ * silently accepting a transfer it cannot land. */
+static inline bool ble_ota_serial_submit(const char *) { return false; }
+static inline void ble_ota_serial_stage(const uint8_t *, size_t) {}
+static inline void ble_ota_serial_pump(void) {}
+static inline bool ble_ota_serial_active(void) { return false; }
